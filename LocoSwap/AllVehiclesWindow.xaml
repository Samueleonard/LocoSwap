<ui:FluentWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Converters="clr-namespace:LocoSwap.Converters"
        xmlns:Language="clr-namespace:LocoSwap.Language;assembly=LocoSwap.Language"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="LocoSwap.AllVehiclesWindow"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Title="{x:Static Language:Resources.all_vehicles}" Height="480" Width="640" MinWidth="480" MinHeight="320">
    <ui:FluentWindow.Resources>
        <Converters:VehicleStatusToImageConverter x:Key="VehicleStatusToImageConverter" />
        <Converters:VehicleImageSourceConverter x:Key="VehicleImageSourceConverter" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static Language:Resources.all_vehicles}" />

        <Grid Grid.Row="1" Margin="12,4,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="VehicleListBox" Grid.Column="0" SelectionMode="Extended" ItemsSource="{Binding Vehicles}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Height="10" Width="10" VerticalAlignment="Center"
                                   Source="{Binding Exists, Converter={StaticResource VehicleStatusToImageConverter}}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding DisplayName}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" Margin="3,0" />

            <GroupBox Grid.Column="2" Header="{x:Static Language:Resources.vehicle_selected}" VerticalAlignment="Top">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static Language:Resources.name}"
                               VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True"
                                Text="{Binding SelectedItem.DisplayName, ElementName=VehicleListBox, Mode=OneWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static Language:Resources.number}"
                               VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True"
                                Text="{Binding SelectedItem.Number, ElementName=VehicleListBox, Mode=OneWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static Language:Resources.path}"
                               VerticalAlignment="Center" Margin="0,0,8,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" TextWrapping="Wrap"
                                Text="{Binding SelectedItem.DisplayXmlPath, ElementName=VehicleListBox, Mode=OneWay, StringFormat='\Assets\{0}'}" />

                    <CheckBox Grid.Row="3" Grid.Column="1" Content="{x:Static Language:Resources.flipped}" IsEnabled="False"
                              Margin="0,0,0,6"
                              IsChecked="{Binding SelectedItem.Flipped, ElementName=VehicleListBox, Mode=OneWay}" />

                    <Image Grid.Row="4" Grid.Column="1" Height="130" HorizontalAlignment="Left"
                           Source="{Binding SelectedItem, Converter={StaticResource VehicleImageSourceConverter}, ElementName=VehicleListBox, Mode=OneWay}" />
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</ui:FluentWindow>
