<ui:FluentWindow x:Class="LocoSwap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocoSwap"
        xmlns:p="clr-namespace:LocoSwap.Properties"
        xmlns:loc="clr-namespace:LocoSwap"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        ResizeMode="NoResize"
        Title="{loc:Loc settings}" Width="600" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Loc settings}" />

        <StackPanel Grid.Row="1" Margin="16,8,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc ts_directory}" VerticalAlignment="Center" Margin="0,6" />
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" IsReadOnly="True"
                                Text="{Binding Source={x:Static p:Settings.Default}, Path=TsPath, Mode=OneWay}" />
                    <ui:Button Grid.Column="1" x:Name="TsPathBrowseButton" Content="{loc:Loc browse}"
                               Margin="8,0,0,0" Click="TsPathBrowseButton_Click" />
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc language}" VerticalAlignment="Center" Margin="0,6" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LanguageComboBox" Margin="0,6"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding LanguageList}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Source={x:Static p:Settings.Default}, Path=Language, Mode=TwoWay}"
                          SelectionChanged="LanguageComboBox_SelectionChanged" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Theme" VerticalAlignment="Center" Margin="0,6" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ThemeComboBox" Margin="0,6"
                          HorizontalAlignment="Stretch"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding Source={x:Static p:Settings.Default}, Path=Theme, Mode=TwoWay}"
                          SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc scenario_name_suffix}" VerticalAlignment="Center" Margin="0,6" />
                <ui:TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                            Text="{Binding Source={x:Static p:Settings.Default}, Path=ScenarioNameSuffix, Mode=TwoWay}" />
            </Grid>

            <CheckBox Margin="0,10,0,0" Content="{loc:Loc check_all_scenario_consists}"
                      IsChecked="{Binding CheckScenarioConsists, Mode=TwoWay, Source={x:Static p:Settings.Default}}" />
            <CheckBox Margin="0,6,0,0" Content="{loc:Loc do_not_auto_archive_workshop_routes}"
                      IsChecked="{Binding DoNotAutoArchiveWorkshopRoutes, Mode=TwoWay, Source={x:Static p:Settings.Default}}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="16,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ui:Button x:Name="CloseButton" Content="{loc:Loc close}" HorizontalAlignment="Right"
                       Appearance="Primary" MinWidth="90" Click="CloseButton_Click" />
        </Border>
    </Grid>
</ui:FluentWindow>
