<ui:FluentWindow x:Class="LocoSwap.ScenarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:LocoSwap.Converters"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:loc="clr-namespace:LocoSwap"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Title="{Binding WindowTitle}" Height="800" Width="1200" MinWidth="980" MinHeight="640"
        Closed="Window_Closed" KeyDown="Window_KeyDown">
    <ui:FluentWindow.Resources>
        <converters:VehicleStatusToImageConverter x:Key="VehicleStatusToImageConverter" />
        <converters:ConsistStatusToImageConverter x:Key="ConsistStatusToImageConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:VehicleImageSourceConverter x:Key="VehicleImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <CollectionViewSource Source="{Binding AvailableVehicles}" x:Key="AvailableVehiclesSource">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="DisplayName"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="Thumb" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="72" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Contained, compact list styling for this window -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <!-- Header band -->
        <Grid Grid.Row="1" Margin="12,4,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center" MaxWidth="520" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc route}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" IsReadOnly="True" Focusable="False"
                            Text="{Binding Route.Name, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc scenario}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Focusable="False"
                            Text="{Binding Scenario.Name, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" MinWidth="160" VerticalAlignment="Center"
                            Visibility="{Binding LoadingGridVisibility}">
                    <TextBlock Text="{Binding LoadingInformation}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="LoadingProgressBar" Height="4" Margin="0,4,0,0" Value="{Binding LoadingProgress}" />
                </StackPanel>

                <ui:DropDownButton Icon="{ui:SymbolIcon ArrowSync24}" Content="{loc:Loc apply_all_rules}" Margin="0,0,6,0">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc only_on_missing_stock}" Click="ApplyAllRulesOnlyOnMissingStock_Click" />
                            <MenuItem Header="{loc:Loc on_all_stock}" Click="ApplyAllRulesOnAllStock_Click" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                <ui:Button x:Name="PresetButton" Icon="{ui:SymbolIcon List24}"
                           Content="{loc:Loc replacement_rules}" Margin="0,0,6,0" Click="PresetButton_Click" />
                <ui:Button x:Name="AllVehiclesListButton" Icon="{ui:SymbolIcon DocumentText24}"
                           Content="{loc:Loc all_vehicles}" Margin="0,0,6,0" Click="AllVehiclesListButton_Click"
                           IsEnabled="{Binding SaveButtonEnabled}" />
                <ui:Button x:Name="SaveButton" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                           Content="{loc:Loc save}" Margin="0,0,6,0" Click="SaveButton_Click"
                           IsEnabled="{Binding SaveButtonEnabled}" />
                <ui:Button Icon="{ui:SymbolIcon QuestionCircle24}" ToolTip="{loc:Loc open_manual}" Click="OpenManual_Click" />
            </StackPanel>
        </Grid>

        <!-- Workspace -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ===== Scenario side ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc consists_in_scenario}" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <ListBox x:Name="ConsistListBox" ItemsSource="{Binding Consists}" SelectionChanged="ConsistListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding IsComplete, Converter={StaticResource ConsistStatusToImageConverter}}" Width="10" Height="10" VerticalAlignment="Center" />
                                    <Image Visibility="{Binding IsPlayerConsist, Converter={StaticResource BoolToVis}}" Source="/LocoSwap;component/Resources/Player.png" Margin="6,0,0,0" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <TextBlock Grid.Row="3" Text="{loc:Loc vehicles_in_selected_consist}" Style="{StaticResource SectionHeader}" Margin="2,4,0,6" />
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid>
                        <ListBox x:Name="VehicleListBox" ItemsSource="{Binding Vehicles}" SelectionMode="Extended" SelectionChanged="VehicleListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Exists, Converter={StaticResource VehicleStatusToImageConverter}}" Width="10" Height="10" VerticalAlignment="Center" />
                                        <Image Source="/Resources/Coupling.png" Visibility="{Binding IsInvolvedInConsistOperation, Converter={StaticResource BoolToVis}}" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock ToolTip="{Binding PossibleSubstitutionDisplayName}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} - {1}m">
                                                    <Binding Path="DisplayName" />
                                                    <Binding Path="Length" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Loc vehicles_in_selected_consist}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=VehicleListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Detail: the scenario vehicle being replaced -->
                <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Loc vehicle_to_be_replaced}" Style="{StaticResource SectionHeader}" />

                        <TextBlock Grid.Row="1" Margin="0,16" Text="{loc:Loc vehicle_to_be_replaced}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItems.Count, ElementName=VehicleListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Grid.Row="1" x:Name="ReplaceDetail">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItems.Count, ElementName=VehicleListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,2,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc name}" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,0,0,4"
                                           Text="{Binding SelectedItem.DisplayName, Mode=OneWay, ElementName=VehicleListBox}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc number}" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,0,0,4"
                                           Text="{Binding SelectedItem.Number, Mode=OneWay, ElementName=VehicleListBox}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc path}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedItem.DisplayXmlPath, Mode=OneWay, ElementName=VehicleListBox, StringFormat=\\Assets\\\{0\}}" />
                            </Grid>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Thumb}" VerticalAlignment="Top">
                                <Image Source="{Binding SelectedItem, Mode=OneWay, ElementName=VehicleListBox, Converter={StaticResource VehicleImageSourceConverter}}" />
                            </Border>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button x:Name="ChangeNumberButton" Content="{loc:Loc change_number}" Margin="0,0,6,0" Click="ChangeNumberButton_Click">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=VehicleListBox, Path=SelectedItems.Count}" Value="1">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button x:Name="FlipButton" Content="{loc:Loc flip}" Margin="0,0,10,0"
                                           IsEnabled="{Binding ElementName=VehicleListBox, Path=SelectedItems.Count}" Click="FlipButton_Click" />
                                <CheckBox Content="{loc:Loc flipped}" VerticalAlignment="Center" IsEnabled="False"
                                          IsChecked="{Binding SelectedItem.Flipped, Mode=OneWay, ElementName=VehicleListBox}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{loc:Loc involved_in_consist_operation}"
                                       Visibility="{Binding SelectedItem.IsInvolvedInConsistOperation, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, ElementName=VehicleListBox}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- ===== Action bar ===== -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0">
                <ui:Button Content="{loc:Loc replace}" Style="{StaticResource ActionButton}" Appearance="Primary" Click="ReplaceButton_Click" x:Name="ReplaceButton" />
                <ui:Button Content="{loc:Loc replace_identical}" Style="{StaticResource ActionButton}" Click="ReplaceIdenticalButton_Click" x:Name="ReplaceIdenticalButton" />
                <CheckBox x:Name="AddAsRule" Content="{loc:Loc and_add_as_rule}" IsChecked="True" Margin="2,2,0,10" />
                <ui:Button Content="{loc:Loc insert_before}" Style="{StaticResource ActionButton}" Click="InsertBeforeButton_Click" x:Name="InsertBeforeButton" />
                <ui:Button Content="{loc:Loc insert_after}" Style="{StaticResource ActionButton}" Click="InsertAfterButton_Click" x:Name="InsertAfterButton" />
                <ui:Button Content="{loc:Loc remove}" Style="{StaticResource ActionButton}" Click="RemoveButton_Click" x:Name="RemoveButton"
                           IsEnabled="{Binding ElementName=VehicleListBox, Path=SelectedItems.Count}" />
                <Separator Margin="0,8" />
                <ui:Button Content="{loc:Loc add_to_rules}" Style="{StaticResource ActionButton}" Click="AddToRulesButton_Click" x:Name="AddToRulesButton" Margin="0" />
            </StackPanel>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- ===== Library side ===== -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="80" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc replace_with}" Style="{StaticResource SectionHeader}" />
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <TreeView x:Name="DirectoryTree" ItemsSource="{Binding Directories}" TreeViewItem.Expanded="TreeView_Expanded">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubDirectories}">
                                <TextBlock Text="{Binding Name}" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsSelected" Value="{Binding Path=IsSelected}"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,6">
                    <ui:Button x:Name="ScanButton" Icon="{ui:SymbolIcon Search24}" Content="{loc:Loc look_up_vehicles}" Margin="0,0,6,0"
                               Click="ScanButton_Click"
                               IsEnabled="{Binding VehicleScanInProgress, Converter={StaticResource InverseBooleanConverter}}" />
                    <ui:Button x:Name="ClearButton" Content="{loc:Loc clear_vehicles}" Margin="0,0,6,0"
                               Click="AvailableVehiclesClearButton_Click"
                               IsEnabled="{Binding ElementName=AvailableVehicleListBox, Path=Items.Count}" />
                    <ui:Button x:Name="CancelScanningButton" Content="{loc:Loc cancel}" Click="CancelScanningButton_Click"
                               Visibility="{Binding VehicleScanInProgress, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ui:TextBox Grid.Row="3" x:Name="AvailableVehicleFilterTextbox" Margin="0,0,0,6"
                            PlaceholderText="{loc:Loc filter}" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                            TextChanged="AvailableVehiclesFilter_TextChanged" />

                <Border Grid.Row="5" Style="{StaticResource Card}">
                    <Grid>
                        <ListBox x:Name="AvailableVehicleListBox" ItemsSource="{Binding Source={StaticResource AvailableVehiclesSource}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} - {1}m">
                                                <Binding Path="DisplayName" />
                                                <Binding Path="Length" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Loc look_up_vehicles}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=AvailableVehicleListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Detail: the replacement vehicle chosen from the library -->
                <Border Grid.Row="6" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Loc new_vehicle_selected}" Style="{StaticResource SectionHeader}" />

                        <TextBlock Grid.Row="1" Margin="0,16" Text="{loc:Loc new_vehicle_selected}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItems.Count, ElementName=AvailableVehicleListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Grid.Row="1">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItems.Count, ElementName=AvailableVehicleListBox}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,2,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc name}" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,0,0,4"
                                           Text="{Binding SelectedItem.DisplayName, Mode=OneWay, ElementName=AvailableVehicleListBox}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc path}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding SelectedItem.DisplayXmlPath, Mode=OneWay, ElementName=AvailableVehicleListBox, StringFormat=\\Assets\\\{0\}}" />
                            </Grid>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Thumb}" VerticalAlignment="Top">
                                <Image Source="{Binding SelectedItem, Mode=OneWay, ElementName=AvailableVehicleListBox, Converter={StaticResource VehicleImageSourceConverter}}" />
                            </Border>

                            <ui:Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AvailableVehicleNumberListButton" HorizontalAlignment="Left"
                                       Margin="0,10,0,0" Content="{loc:Loc numbering_list}" Click="AvailableVehicleNumberListButton_Click"
                                       IsEnabled="{Binding ElementName=AvailableVehicleListBox, Path=SelectedItems.Count}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
