<ui:FluentWindow x:Class="LocoSwap.ScenarioEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:LocoSwap.Converters"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:loc="clr-namespace:LocoSwap"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Title="{Binding WindowTitle}" Height="840" Width="1240" MinWidth="960" MinHeight="620"
        Closed="Window_Closed" KeyDown="Window_KeyDown">
    <ui:FluentWindow.Resources>
        <converters:VehicleStatusToImageConverter x:Key="VehicleStatusToImageConverter" />
        <converters:ConsistStatusToImageConverter x:Key="ConsistStatusToImageConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:VehicleImageSourceConverter x:Key="VehicleImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <CollectionViewSource Source="{Binding AvailableVehicles}" x:Key="AvailableVehiclesSource">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="DisplayName"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" />

        <!-- Header band: scenario identity + top-level actions -->
        <Grid Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc route}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" IsReadOnly="True" Focusable="False"
                            Text="{Binding Route.Name, Mode=OneWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc scenario}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Focusable="False"
                            Text="{Binding Scenario.Name, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0" MinWidth="180"
                            Visibility="{Binding LoadingGridVisibility}">
                    <TextBlock Text="{Binding LoadingInformation}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="LoadingProgressBar" Height="4" Margin="0,4,0,0"
                                 Value="{Binding LoadingProgress}" />
                </StackPanel>

                <ui:DropDownButton Icon="{ui:SymbolIcon ArrowSync24}" Content="{loc:Loc apply_all_rules}" Margin="0,0,6,0">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc only_on_missing_stock}" Click="ApplyAllRulesOnlyOnMissingStock_Click" />
                            <MenuItem Header="{loc:Loc on_all_stock}" Click="ApplyAllRulesOnAllStock_Click" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                <ui:Button x:Name="PresetButton" Icon="{ui:SymbolIcon List24}"
                           Content="{loc:Loc replacement_rules}" Margin="0,0,6,0" Click="PresetButton_Click" />
                <ui:Button x:Name="AllVehiclesListButton" Icon="{ui:SymbolIcon DocumentText24}"
                           Content="{loc:Loc all_vehicles}" Margin="0,0,6,0" Click="AllVehiclesListButton_Click"
                           IsEnabled="{Binding SaveButtonEnabled}" />
                <ui:Button x:Name="SaveButton" Icon="{ui:SymbolIcon Save24}" Appearance="Primary"
                           Content="{loc:Loc save}" Margin="0,0,6,0" Click="SaveButton_Click"
                           IsEnabled="{Binding SaveButtonEnabled}" />
                <ui:Button Icon="{ui:SymbolIcon QuestionCircle24}" ToolTip="{loc:Loc open_manual}" Click="OpenManual_Click" />
            </StackPanel>
        </Grid>

        <!-- Workspace: three resizable columns -->
        <Grid Grid.Row="2" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: consists + vehicles in the scenario -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc consists_in_scenario}" Style="{StaticResource SectionHeader}" />
                    <ListBox x:Name="ConsistListBox" ItemsSource="{Binding Consists}" SelectionChanged="ConsistListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding IsComplete, Converter={StaticResource ConsistStatusToImageConverter}}" Width="10" Height="10" VerticalAlignment="Center" />
                                    <Image Visibility="{Binding IsPlayerConsist, Converter={StaticResource BoolToVis}}" Source="/LocoSwap;component/Resources/Player.png" Margin="6,0,0,0" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" Margin="0,2" />

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc vehicles_in_selected_consist}" Style="{StaticResource SectionHeader}" />
                    <ListBox x:Name="VehicleListBox" ItemsSource="{Binding Vehicles}" SelectionMode="Extended" SelectionChanged="VehicleListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Exists, Converter={StaticResource VehicleStatusToImageConverter}}" Width="10" Height="10" VerticalAlignment="Center" />
                                    <Image Source="/Resources/Coupling.png" Visibility="{Binding IsInvolvedInConsistOperation, Converter={StaticResource BoolToVis}}" Height="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock ToolTip="{Binding PossibleSubstitutionDisplayName}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} - {1}m">
                                                <Binding Path="DisplayName" />
                                                <Binding Path="Length" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Margin="3,0" />

            <!-- Column 2: replace/insert actions and vehicle details -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <GroupBox Header="{loc:Loc vehicle_to_be_replaced}" Margin="0,0,0,10">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc name}" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                            <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True"
                                        Text="{Binding SelectedItem.DisplayName, Mode=OneWay, ElementName=VehicleListBox}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc number}" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                            <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True"
                                        Text="{Binding SelectedItem.Number, Mode=OneWay, ElementName=VehicleListBox}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc path}" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                            <ui:TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" TextWrapping="Wrap"
                                        Text="{Binding SelectedItem.DisplayXmlPath, Mode=OneWay, ElementName=VehicleListBox, StringFormat='\Assets\{0}'}" />

                            <Image Grid.Row="3" Grid.Column="1" Height="130" HorizontalAlignment="Left" Margin="0,2,0,8"
                                   Source="{Binding SelectedItem, Mode=OneWay, ElementName=VehicleListBox, Converter={StaticResource VehicleImageSourceConverter}}" />

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <ui:Button x:Name="ChangeNumberButton" Content="{loc:Loc change_number}" Margin="0,0,6,0" Click="ChangeNumberButton_Click">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=VehicleListBox, Path=SelectedItems.Count}" Value="1">
                                                    <Setter Property="IsEnabled" Value="True"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button x:Name="FlipButton" Content="{loc:Loc flip}" Margin="0,0,10,0"
                                           IsEnabled="{Binding ElementName=VehicleListBox, Path=SelectedItems.Count}" Click="FlipButton_Click" />
                                <CheckBox Content="{loc:Loc flipped}" VerticalAlignment="Center" IsEnabled="False"
                                          IsChecked="{Binding SelectedItem.Flipped, Mode=OneWay, ElementName=VehicleListBox}" />
                            </StackPanel>

                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,40,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Text="{loc:Loc involved_in_consist_operation}"
                                       Visibility="{Binding SelectedItem.IsInvolvedInConsistOperation, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, ElementName=VehicleListBox}" />
                        </Grid>
                    </GroupBox>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <ui:Button Content="{loc:Loc replace}" HorizontalAlignment="Stretch" Margin="0,0,3,3" Appearance="Primary" Click="ReplaceButton_Click" x:Name="ReplaceButton" />
                        <ui:Button Content="{loc:Loc replace_identical}" HorizontalAlignment="Stretch" Margin="3,0,0,3" Click="ReplaceIdenticalButton_Click" x:Name="ReplaceIdenticalButton" />
                        <ui:Button Content="{loc:Loc insert_before}" HorizontalAlignment="Stretch" Margin="0,3,3,3" Click="InsertBeforeButton_Click" x:Name="InsertBeforeButton" />
                        <ui:Button Content="{loc:Loc insert_after}" HorizontalAlignment="Stretch" Margin="3,3,0,3" Click="InsertAfterButton_Click" x:Name="InsertAfterButton" />
                        <ui:Button Content="{loc:Loc remove}" HorizontalAlignment="Stretch" Margin="0,3,3,0" Click="RemoveButton_Click" x:Name="RemoveButton"
                                   IsEnabled="{Binding ElementName=VehicleListBox, Path=SelectedItems.Count}" />
                        <ui:Button Content="{loc:Loc add_to_rules}" HorizontalAlignment="Stretch" Margin="3,3,0,0" Click="AddToRulesButton_Click" x:Name="AddToRulesButton" />
                    </UniformGrid>
                    <CheckBox x:Name="AddAsRule" Content="{loc:Loc and_add_as_rule}" IsChecked="True" Margin="0,0,0,10" />

                    <GroupBox Header="{loc:Loc new_vehicle_selected}">
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc name}" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                            <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True"
                                        Text="{Binding SelectedItem.DisplayName, Mode=OneWay, ElementName=AvailableVehicleListBox}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc path}" Style="{StaticResource FieldLabel}" Margin="0,0,8,6" />
                            <ui:TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" TextWrapping="Wrap"
                                        Text="{Binding SelectedItem.DisplayXmlPath, Mode=OneWay, ElementName=AvailableVehicleListBox, StringFormat='\Assets\{0}'}" />

                            <Image Grid.Row="2" Grid.Column="1" Height="130" HorizontalAlignment="Left" Margin="0,2,0,8"
                                   Source="{Binding SelectedItem, Mode=OneWay, ElementName=AvailableVehicleListBox, Converter={StaticResource VehicleImageSourceConverter}}" />

                            <ui:Button Grid.Row="3" Grid.Column="1" x:Name="AvailableVehicleNumberListButton" HorizontalAlignment="Left"
                                       Content="{loc:Loc numbering_list}" Click="AvailableVehicleNumberListButton_Click"
                                       IsEnabled="{Binding ElementName=AvailableVehicleListBox, Path=SelectedItems.Count}" />
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Margin="3,0" />

            <!-- Column 3: asset browser + available vehicles -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Loc replace_with}" Style="{StaticResource SectionHeader}" />
                <TreeView x:Name="DirectoryTree" Grid.Row="1" ItemsSource="{Binding Directories}" TreeViewItem.Expanded="TreeView_Expanded">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding SubDirectories}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding Path=IsSelected}"/>
                        </Style>
                    </TreeView.Resources>
                </TreeView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,6">
                    <ui:Button x:Name="ScanButton" Icon="{ui:SymbolIcon Search24}" Content="{loc:Loc look_up_vehicles}" Margin="0,0,6,0"
                               Click="ScanButton_Click"
                               IsEnabled="{Binding VehicleScanInProgress, Converter={StaticResource InverseBooleanConverter}}" />
                    <ui:Button x:Name="ClearButton" Content="{loc:Loc clear_vehicles}" Margin="0,0,6,0"
                               Click="AvailableVehiclesClearButton_Click"
                               IsEnabled="{Binding ElementName=AvailableVehicleListBox, Path=Items.Count}" />
                    <ui:Button x:Name="CancelScanningButton" Content="{loc:Loc cancel}" Click="CancelScanningButton_Click"
                               Visibility="{Binding VehicleScanInProgress, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ui:TextBox Grid.Row="3" x:Name="AvailableVehicleFilterTextbox" Margin="0,0,0,6"
                            PlaceholderText="{loc:Loc filter}" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                            TextChanged="AvailableVehiclesFilter_TextChanged" />

                <ListBox x:Name="AvailableVehicleListBox" Grid.Row="4" ItemsSource="{Binding Source={StaticResource AvailableVehiclesSource}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1}m">
                                        <Binding Path="DisplayName" />
                                        <Binding Path="Length" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
