<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LocoSwap</RootNamespace>
    <AssemblyName>LocoSwap</AssemblyName>
    <ApplicationIcon>Resources\icon_128.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Version>1.7.0.0</Version>
    <FileVersion>1.7.0.0</FileVersion>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <Product>LocoSwap</Product>
    <AssemblyTitle>LocoSwap</AssemblyTitle>
    <Copyright>Copyright © 2020</Copyright>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocoSwap.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocoSwap.Language\LocoSwap.Language.csproj" />
  </ItemGroup>

</Project>
